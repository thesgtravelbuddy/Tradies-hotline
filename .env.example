# Production requires PostgreSQL. Without this, development uses an in-memory store.
DATABASE_URL=postgres://user:password@localhost:5432/tradies_hotline
# Separate PostgreSQL database used only by `npm run test:db`.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/tradies_hotline_test
BUSINESS_ID=replace-with-business-uuid
PUBLIC_BUSINESS_ID=replace-with-business-uuid
# JSON map of long random bearer tokens to business UUIDs. Never expose these to customers.
OWNER_AUTH_TOKENS={"replace-with-long-random-owner-token":"replace-with-business-uuid"}
PORT=3000
BUSINESS_NAME=Your Trade Business
REQUIRE_EMAIL=false

SPACES_REGION="your-space-region"
SPACES_ENDPOINT="https://your-space-region.digitaloceanspaces.com"
SPACES_KEY="your-digitalocean-space-key"
SPACES_SECRET="your-digitalocean-space-secret"
SPACES_BUCKET="your-space-bucket"
